# Copy to .env for local development. Every ACM_* variable is documented here.
ACM_ENV=dev

# CASMI 2026 workload (workloads/casmi)
# Kaggle API credentials for `casmi download`; the account must accept the competition rules (THE-77).
KAGGLE_USERNAME=
KAGGLE_KEY=
# Object store URL for integration tests of `casmi publish/fetch`, e.g. s3://acm-artifacts
# (S3 endpoint and keys come from the standard AWS_* variables, e.g. AWS_ENDPOINT_URL for MinIO).
CASMI_TEST_STORE_URL=
