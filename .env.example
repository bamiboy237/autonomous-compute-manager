# Copy to .env for local development. Every ACM_* variable is documented here.
# dev | test | prod
ACM_ENV=dev
# DEBUG | INFO | WARNING | ERROR | CRITICAL
ACM_LOG_LEVEL=INFO
# json | console
ACM_LOG_FORMAT=json

# Postgres (system of record)
ACM_DB__URL=postgresql+asyncpg://acm:acm@localhost:5432/acm
ACM_DB__POOL_SIZE=10
ACM_DB__ECHO=false

# Temporal
ACM_TEMPORAL__ADDRESS=localhost:7233
ACM_TEMPORAL__NAMESPACE=default
ACM_TEMPORAL__TLS=false
# ACM_TEMPORAL__API_KEY=
ACM_TEMPORAL__TASK_QUEUE_CONTROL=acm-control
ACM_TEMPORAL__TASK_QUEUE_AGENTS=acm-agents
ACM_TEMPORAL__TASK_QUEUE_IO=acm-io

# NATS JetStream
ACM_NATS__URL=nats://localhost:4222
# ACM_NATS__TOKEN=
# ACM_NATS__CREDS_FILE=

# ClickHouse (HTTP interface)
ACM_CLICKHOUSE__HOST=localhost
ACM_CLICKHOUSE__PORT=8123
ACM_CLICKHOUSE__DATABASE=acm
ACM_CLICKHOUSE__USERNAME=default
ACM_CLICKHOUSE__PASSWORD=
ACM_CLICKHOUSE__SECURE=false

# Object storage (S3-compatible; MinIO locally)
ACM_STORAGE__ENDPOINT_URL=http://localhost:9000
ACM_STORAGE__BUCKET=acm
ACM_STORAGE__REGION=us-east-1
# ACM_STORAGE__ACCESS_KEY_ID=
# ACM_STORAGE__SECRET_ACCESS_KEY=

# Models (Meta Model API for reasoning/code; Llama endpoint for triage)
# ACM_MODELS__META_API_BASE_URL=
# ACM_MODELS__META_API_KEY=
# ACM_MODELS__REASONING_MODEL=
# ACM_MODELS__CODE_MODEL=
# ACM_MODELS__TRIAGE_BASE_URL=
# ACM_MODELS__TRIAGE_API_KEY=
# ACM_MODELS__TRIAGE_MODEL=
