# Copy to .env for local development. Every ACM_* variable is documented here.
# dev | test | prod
ACM_ENV=dev

# --- Application settings (acm_core.settings; nested sections use `__`) --------------
# Values below match the dev stack.
# DEBUG | INFO | WARNING | ERROR | CRITICAL
ACM_LOG_LEVEL=INFO
# json | console
ACM_LOG_FORMAT=json

# Postgres (system of record)
ACM_DB__URL=postgresql+asyncpg://acm:acm@localhost:5432/acm
ACM_DB__POOL_SIZE=10
ACM_DB__ECHO=false

# Temporal
ACM_TEMPORAL__ADDRESS=localhost:7233
ACM_TEMPORAL__NAMESPACE=default
ACM_TEMPORAL__TLS=false
# ACM_TEMPORAL__API_KEY=
ACM_TEMPORAL__TASK_QUEUE_CONTROL=acm-control
ACM_TEMPORAL__TASK_QUEUE_AGENTS=acm-agents
ACM_TEMPORAL__TASK_QUEUE_IO=acm-io

# NATS JetStream
ACM_NATS__URL=nats://localhost:4222
ACM_NATS__TOKEN=acm-dev-token
# ACM_NATS__CREDS_FILE=

# ClickHouse (HTTP interface)
ACM_CLICKHOUSE__HOST=localhost
ACM_CLICKHOUSE__PORT=8123
ACM_CLICKHOUSE__DATABASE=acm
ACM_CLICKHOUSE__USERNAME=acm
ACM_CLICKHOUSE__PASSWORD=acm
ACM_CLICKHOUSE__SECURE=false

# Object storage (S3-compatible; MinIO locally)
ACM_STORAGE__ENDPOINT_URL=http://localhost:9000
ACM_STORAGE__BUCKET=acm
ACM_STORAGE__REGION=us-east-1
ACM_STORAGE__ACCESS_KEY_ID=acm
ACM_STORAGE__SECRET_ACCESS_KEY=acm-dev-secret

# Models (Meta Model API for reasoning/code; Llama endpoint for triage)
# ACM_MODELS__META_API_BASE_URL=
# ACM_MODELS__META_API_KEY=
# ACM_MODELS__REASONING_MODEL=
# ACM_MODELS__CODE_MODEL=
# ACM_MODELS__TRIAGE_BASE_URL=
# ACM_MODELS__TRIAGE_API_KEY=
# ACM_MODELS__TRIAGE_MODEL=

# --- Dev stack (deploy/compose/compose.yaml) -------------------------------------------
# Defaults below match the Compose file, so the stack also starts without a .env.
# Set COMPOSE_PROFILES=observability to also start otel-collector and Grafana.

# Host interface the stack's ports bind to. Use 0.0.0.0 to expose them on the network.
ACM_BIND_HOST=127.0.0.1

# Postgres 17 + pgvector (system of record; also hosts the temporal* databases).
ACM_POSTGRES_PORT=5432
ACM_POSTGRES_USER=acm
ACM_POSTGRES_PASSWORD=acm
ACM_POSTGRES_DB=acm

# Temporal frontend (gRPC) and Web UI.
ACM_TEMPORAL_PORT=7233
ACM_TEMPORAL_NAMESPACE=default
ACM_TEMPORAL_UI_PORT=8233

# NATS with JetStream. Clients authenticate with the token.
ACM_NATS_PORT=4222
ACM_NATS_MONITOR_PORT=8222
ACM_NATS_TOKEN=acm-dev-token

# ClickHouse (HTTP and native protocol).
ACM_CLICKHOUSE_HTTP_PORT=8123
ACM_CLICKHOUSE_NATIVE_PORT=19000
ACM_CLICKHOUSE_USER=acm
ACM_CLICKHOUSE_PASSWORD=acm
ACM_CLICKHOUSE_DB=acm

# S3-compatible object store (MinIO in dev). The bucket is created by `just up`.
ACM_MINIO_PORT=9000
ACM_MINIO_CONSOLE_PORT=9001
ACM_S3_ACCESS_KEY=acm
ACM_S3_SECRET_KEY=acm-dev-secret
ACM_S3_BUCKET=acm

# Observability profile: OTLP collector and Grafana.
ACM_OTEL_GRPC_PORT=4317
ACM_OTEL_HTTP_PORT=4318
ACM_GRAFANA_PORT=3000
ACM_GRAFANA_ADMIN_USER=admin
ACM_GRAFANA_ADMIN_PASSWORD=admin
